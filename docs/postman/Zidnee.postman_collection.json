								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"  const body = pm.response.json();",
									"  if (body.token) pm.environment.set('authToken', body.token);",
									"  if (body.user?.id) pm.environment.set('userId', body.user.id);",
