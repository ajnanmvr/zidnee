{
	"name": "@repo/api",
	"version": "1.0.0",
	"description": "Express API server",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"seed": "tsx scripts/seed.ts",
		"swagger:generate": "tsx scripts/generate-swagger.ts",
		"swagger:build": "pnpm build && pnpm swagger:generate",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@repo/schema": "workspace:*",
		"bcryptjs": "^2.4.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"js-yaml": "^4.1.1",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.4.1",
		"morgan": "^1.10.1",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/js-yaml": "^4.0.9",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/morgan": "^1.9.10",
		"@types/node": "^24.12.2",
		"@types/supertest": "^6.0.3",
		"@types/swagger-ui-express": "^4.1.8",
		"mongodb-memory-server": "^10.1.4",
		"supertest": "^7.1.1",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vitest": "^3.2.4"
	}
}
