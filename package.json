{
	"name": "zidnee",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:schema": "pnpm --filter @repo/schema build",
		"build:packages": "pnpm build:schema",
		"build:api": "pnpm --filter api build",
		"build:web": "pnpm --filter web build",
		"build:apps": "pnpm build:web && pnpm build:api",
		"build:all": "pnpm build:packages && pnpm build:apps",
		"start:prod": "pnpm build:all && pnpm --parallel --filter @repo/api start --filter @repo/web start",
		"dev": "turbo run dev",
		"dev:api": "pnpm --filter api dev",
		"dev:web": "pnpm --filter web dev",
		"seed": "pnpm --filter api seed",
		"seed:api": "pnpm --filter api seed",
		"test:api": "pnpm --filter api test",
		"swagger:generate": "pnpm --filter api swagger:generate",
		"lint": "turbo run lint",
		"fix": "biome check --write .",
		"fix:api": "biome check --write apps/server",
		"fix:web": "biome check --write apps/client",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"clean": "node scripts/clean.mjs",
		"clean:all": "node scripts/clean.mjs --all"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@types/js-yaml": "^4.0.9",
		"@types/swagger-ui-express": "^4.1.8",
		"turbo": "^2.9.6",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@11.1.0",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@types/html2canvas": "^1.0.0",
		"html2canvas": "^1.4.1",
		"js-yaml": "^4.1.1",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1"
	}
}
